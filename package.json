{
  "name": "wisemapping-front-end",
  "version": "6.0.1",
  "packageManager": "yarn@4.18.1",
  "private": true,
  "homepage": "https://www.wisemapping.com/opensource/",
  "license": "http://www.wisemapping.org/license",
  "author": {
    "name": "Paulo Veiga",
    "email": "pveiga@wisemapping.com"
  },
  "contributors": [
    "Ezequiel Bergamaschi"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "clean": "lerna run clean --parallel && lerna clean --yes && rm -rf node_modules && yarn install",
    "lint": "lerna run lint --stream",
    "lint:fix": "lerna run lint:fix --stream",
    "playground": "lerna run playground --stream",
    "prepare": "husky",
    "test": "lerna run test --stream",
    "test:integration": "lerna run test:integration --stream",
    "test:unit": "lerna run test:unit --stream"
  },
  "lint-staged": {
    "packages/mindplot/{src,test}/**/*.{ts,tsx}": [
      "cd packages/mindplot && eslint --fix",
      "prettier --write"
    ],
    "packages/editor/src/**/*.{ts,tsx}": [
      "cd packages/editor && eslint --fix",
      "prettier --write"
    ],
    "packages/editor/cypress/**/*.ts": [
      "cd packages/editor && eslint --fix",
      "prettier --write"
    ],
    "packages/webapp/src/**/*.{ts,tsx}": [
      "cd packages/webapp && eslint --fix",
      "prettier --write"
    ],
    "packages/web2d/{src,test}/**/*.{ts,tsx}": [
      "cd packages/web2d && eslint --fix",
      "prettier --write"
    ],
    "**/*.{js,jsx}": [
      "prettier --write"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      "last 2 chrome versions",
      "last 2 edge versions",
      "last 2 firefox versions",
      "last 2 safari versions"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "defaults": [
      "last 2 chrome versions",
      "last 2 edge versions",
      "last 2 firefox versions",
      "last 2 safari versions"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-typescript": "^8.0.1",
    "@babel/register": "^8.0.6",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@formatjs/cli": "^6.16.32",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.12.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-diff": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lerna": "^10.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "start-server-and-test": "^3.0.12",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "update-browserslist-db": "^1.3.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "resolutions": {
    "lerna/js-yaml": "^4.3.2",
    "nx/smol-toml": "^1.7.1"
  }
}
