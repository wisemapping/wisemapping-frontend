{
  "name": "@wisemapping/web2d",
  "version": "6.0.1",
  "description": "WiseMapping - Web2D Render Library",
  "homepage": "https://www.wisemapping.com/opensource/",
  "repository": {
    "type": "git",
    "url": "git@github.com:wisemapping/wisemapping-frontend.git"
  },
  "author": "Paulo Veiga <pveiga@wisemapping.com>",
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist node_modules/.cache storybook-static cypress/screenshots cypress/videos debug-storybook.log .eslintcache",
    "cy:open": "cypress open",
    "cy:run": "cypress run --browser chrome",
    "dev": "vite build --watch",
    "lint": "npx eslint src test --ext js,ts",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p ${PORT:-6006} --quiet",
    "test": "yarn test:unit && yarn test:integration",
    "test:integration": "PORT=6106 node ../../scripts/run-storybook-cypress.js",
    "test:unit": "jest ./test/unit --coverage --silent",
    "test:unit:update-goldens": "UPDATE_GOLDENS=1 jest ./test/unit/goldens.test.ts",
    "test:visual": "VISUAL_SNAPSHOTS=verify yarn test:integration",
    "test:visual:update": "VISUAL_SNAPSHOTS=update yarn test:integration"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^8.0.1",
    "@mdx-js/react": "^3.1.1",
    "@simonsmith/cypress-image-snapshot": "^11.0.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/html-vite": "^10.6.1",
    "@types/jest": "^30.0.0",
    "cypress": "^16.1.1",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "storybook": "^10.6.1",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.com"
  }
}
