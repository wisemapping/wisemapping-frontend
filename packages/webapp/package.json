{
  "name": "@wisemapping/webapp",
  "version": "6.0.1",
  "homepage": "https://www.wisemapping.com/opensource/",
  "repository": {
    "type": "git",
    "url": "git@github.com:wisemapping/wisemapping-frontend.git"
  },
  "license": "MIT",
  "author": "Paulo Veiga <pveiga@wisemapping.com>",
  "files": [
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "clean": "rm -rf dist node_modules/.cache cypress/screenshots cypress/videos cypress/downloads debug-storybook.log test-results.json .eslintcache",
    "cy:open": "npx cypress open",
    "cy:run": "npx cypress run --browser chrome",
    "dev": "vite",
    "i18n:compile": "sh -c 'for lang in es en fr de zh zh-CN ru uk ja pt it hi ar; do formatjs compile lang/${lang}.json --ast --out-file src/compiled-lang/${lang}.json; done'",
    "i18n:extract": "formatjs extract 'src/**/*.ts*' --ignore 'src/@types/**/*' --preserve-whitespace --out-file lang/en.json",
    "lint": "eslint src test eslint.config.mjs vite.config.mts .storybook --ext js,ts,tsx",
    "lint:fix": "eslint src test eslint.config.mjs vite.config.mts .storybook --ext js,ts,tsx --fix",
    "start": "vite",
    "storybook": "storybook dev -p ${PORT:-6007} --quiet",
    "build-storybook": "storybook build",
    "test": "yarn test:unit && yarn test:integration",
    "test:integration": "PORT=3000 CYPRESS_BASE_URL=http://localhost:3000 npx start-server-and-test 'vite --port 3000' http-get://localhost:3000 cy:run",
    "test:unit": "jest --coverage --silent",
    "start:dev": "APP_CONFIG_TYPE='file:dev' vite"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google-recaptcha/react": "^2.5.3",
    "@mui/icons-material": "^9.4.0",
    "@mui/lab": "^9.0.0-beta.9",
    "@mui/material": "^9.4.0",
    "@tanstack/react-query": "^5.104.1",
    "@wisemapping/editor": "*",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "loglevel": "^1.9.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-ga4": "^3.0.1",
    "react-helmet-async": "^3.0.0",
    "react-intl": "^12.1.3",
    "react-router": "^8.4.0",
    "styled-components": "^6.5.3",
    "universal-cookie": "^8.1.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@formatjs/cli": "^6.16.32",
    "@mdx-js/react": "^3.1.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "babel-jest": "^30.5.2",
    "cypress": "^16.1.1",
    "cypress-axe": "^1.7.0",
    "eslint": "^10.12.0",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-transform-stub": "^2.0.0",
    "storybook": "^10.6.1",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "private": true
}
