{
  // Type checks the Vercel functions at the root, api/ and middleware.ts (`yarn lint:root`).
  // Not named tsconfig.json, so the Vercel builders keep compiling them with their own defaults.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["api/**/*.ts", "middleware.ts"]
}
